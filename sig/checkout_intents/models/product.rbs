module CheckoutIntents
  module Models
    type product =
      {
        id: String,
        availability: ::CheckoutIntents::Models::product_availability,
        brand: String?,
        description: String?,
        images: ::Array[::CheckoutIntents::ProductImage],
        is_purchasable: bool,
        name: String,
        price: ::CheckoutIntents::Money,
        sku: String?,
        url: String,
        variant_dimensions: ::Array[::CheckoutIntents::Product::VariantDimension],
        variants: ::Array[::CheckoutIntents::Product::Variant]
      }

    class Product < ::CheckoutIntents::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor availability: ::CheckoutIntents::Models::product_availability

      attr_accessor brand: String?

      attr_accessor description: String?

      attr_accessor images: ::Array[::CheckoutIntents::ProductImage]

      attr_accessor is_purchasable: bool

      attr_accessor name: String

      attr_accessor price: ::CheckoutIntents::Money

      attr_accessor sku: String?

      attr_accessor url: String

      attr_reader variant_dimensions: ::Array[::CheckoutIntents::Product::VariantDimension]?

      def variant_dimensions=: (
        ::Array[::CheckoutIntents::Product::VariantDimension]
      ) -> ::Array[::CheckoutIntents::Product::VariantDimension]

      attr_reader variants: ::Array[::CheckoutIntents::Product::Variant]?

      def variants=: (
        ::Array[::CheckoutIntents::Product::Variant]
      ) -> ::Array[::CheckoutIntents::Product::Variant]

      def initialize: (
        id: String,
        availability: ::CheckoutIntents::Models::product_availability,
        brand: String?,
        description: String?,
        images: ::Array[::CheckoutIntents::ProductImage],
        is_purchasable: bool,
        name: String,
        price: ::CheckoutIntents::Money,
        sku: String?,
        url: String,
        ?variant_dimensions: ::Array[::CheckoutIntents::Product::VariantDimension],
        ?variants: ::Array[::CheckoutIntents::Product::Variant]
      ) -> void

      def to_hash: -> {
        id: String,
        availability: ::CheckoutIntents::Models::product_availability,
        brand: String?,
        description: String?,
        images: ::Array[::CheckoutIntents::ProductImage],
        is_purchasable: bool,
        name: String,
        price: ::CheckoutIntents::Money,
        sku: String?,
        url: String,
        variant_dimensions: ::Array[::CheckoutIntents::Product::VariantDimension],
        variants: ::Array[::CheckoutIntents::Product::Variant]
      }

      type variant_dimension = { name: String, values: ::Array[String] }

      class VariantDimension < ::CheckoutIntents::Internal::Type::BaseModel
        attr_accessor name: String

        attr_accessor values: ::Array[String]

        def initialize: (name: String, values: ::Array[String]) -> void

        def to_hash: -> { name: String, values: ::Array[String] }
      end

      type variant =
        {
          attributes: ::Hash[Symbol, String],
          availability: ::CheckoutIntents::Models::product_availability,
          images: ::Array[::CheckoutIntents::ProductImage],
          name: String?,
          price: ::CheckoutIntents::Money,
          sku: String?
        }

      class Variant < ::CheckoutIntents::Internal::Type::BaseModel
        attr_accessor attributes: ::Hash[Symbol, String]

        attr_accessor availability: ::CheckoutIntents::Models::product_availability

        attr_accessor images: ::Array[::CheckoutIntents::ProductImage]

        attr_accessor name: String?

        attr_accessor price: ::CheckoutIntents::Money

        attr_accessor sku: String?

        def initialize: (
          attributes: ::Hash[Symbol, String],
          availability: ::CheckoutIntents::Models::product_availability,
          images: ::Array[::CheckoutIntents::ProductImage],
          name: String?,
          price: ::CheckoutIntents::Money,
          sku: String?
        ) -> void

        def to_hash: -> {
          attributes: ::Hash[Symbol, String],
          availability: ::CheckoutIntents::Models::product_availability,
          images: ::Array[::CheckoutIntents::ProductImage],
          name: String?,
          price: ::CheckoutIntents::Money,
          sku: String?
        }
      end
    end
  end
end
